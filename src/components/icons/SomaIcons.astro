---
import { GENERATED_ICONS } from './generated-icons.ts';

/**
 * Soma Icon Set — SVG icons for the AMPS layers + system + utility icons.
 * Uses currentColor for theme compatibility. Designed at 24x24 viewBox.
 *
 * The Lucide-sourced set below (extensions, skills, muscles, protocols, automations, scripts,
 * memory, wand, brain, shield, upload, link, mic, wrench, pen-line, ruler, flask, arrow-right,
 * settings, layers, circle-dot, search, dna) is no longer hand-copied SVG path data — it is
 * declared by id in icons.config.json, fetched from api.iconify.design at build time, and
 * inlined via GENERATED_ICONS (scripts/gather-icons.mjs, prebuild hook). A declared id that
 * fails to fetch fails the build loudly; there is no runtime CDN fallback.
 *
 * Hand-drawn customs — sigma, terminal, you, pi — are NOT in the Iconify set and stay hardcoded
 * below exactly as before.
 *
 * Source audit: browser-tools/examples/icon-audit-soma-2026-03-11.html
 */

interface Props {
  name: 'extensions' | 'skills' | 'muscles' | 'protocols' | 'automations' | 'scripts'
    | 'memory' | 'sigma' | 'terminal' | 'you' | 'pi' | 'dna'
    | 'wand' | 'brain' | 'shield' | 'upload' | 'link' | 'mic'
    | 'wrench' | 'pen-line' | 'ruler' | 'flask'
    | 'arrow-right' | 'settings' | 'layers' | 'circle-dot' | 'search';
  size?: number;
  class?: string;
}

const { name, size = 24, class: className = '' } = Astro.props;
const generated = GENERATED_ICONS[name];
---

{/* Lucide-sourced set — build-time fetched + inlined, see generated-icons.ts */}
{generated && (
  <svg width={size} height={size} viewBox={generated.viewBox} class={className} aria-hidden="true" set:html={generated.inner} />
)}

{/* Sigma — the Soma mark (custom) */}
{name === 'sigma' && (
  <svg width={size} height={size} viewBox="0 0 24 24" fill="none" class={className} aria-hidden="true">
    <path d="M18 5H7l5 7-5 7h11" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
  </svg>
)}

{/* Terminal — command prompt (custom) */}
{name === 'terminal' && (
  <svg width={size} height={size} viewBox="0 0 24 24" fill="none" class={className} aria-hidden="true">
    <rect x="3" y="4" width="18" height="16" rx="2" stroke="currentColor" stroke-width="1.5"/>
    <path d="M7 15h4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
    <path d="M7 9l3 3-3 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
  </svg>
)}

{/* You — user/person (custom) */}
{name === 'you' && (
  <svg width={size} height={size} viewBox="0 0 24 24" fill="none" class={className} aria-hidden="true">
    <circle cx="12" cy="8" r="4" stroke="currentColor" stroke-width="1.5"/>
    <path d="M4 20c0-3.3 3.6-6 8-6s8 2.7 8 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
  </svg>
)}

{/* Pi — the runtime framework (custom) */}
{name === 'pi' && (
  <svg width={size} height={size} viewBox="0 0 24 24" fill="none" class={className} aria-hidden="true">
    <path d="M6 7h12" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
    <path d="M9 7v10" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
    <path d="M15 7v10" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
    <path d="M6 7c0-1.7 1.3-3 3-3h6c1.7 0 3 1.3 3 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" opacity="0.4"/>
  </svg>
)}

{/* extensions, skills, muscles, protocols, automations, scripts, memory, wand, brain, shield,
   upload, link, mic, wrench, pen-line, ruler, flask, arrow-right, settings, layers, circle-dot,
   search, dna — all rendered by the `generated &&` block above. See icons.config.json for the
   declared Iconify id per name. */}
