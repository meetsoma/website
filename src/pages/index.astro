---
import Layout from '../layouts/Layout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import Icon from '../components/icons/SomaIcons.astro';
import TemplateCarousel from '../components/islands/TemplateCarousel.tsx';
import { getPublishedBlogPosts, blogPostUrl } from '../lib/blog';
import somaVersion from '../data/soma-version.json';

const posts = await getPublishedBlogPosts();
const recentPosts = posts.slice(0, 3);
---

<Layout
  title="meetsoma core — now open source · Soma, the agent that remembers"
  description="meetsoma core is the open-source harness for Soma, an AI coding agent that keeps its memory across sessions, grows its own tools, and picks up where you left off."
  canonicalUrl="https://soma.gravicity.ai"
>
  <main class="container">
    <!-- Hero — the portal: rings breathe, memory motes drift inward to the agent -->
    <header class="portal">
      <div class="portal-stage" aria-hidden="true">
        <canvas class="portal-motes"></canvas>
      </div>

      <div class="portal-core">
        <div class="portal-rings" aria-hidden="true">
          <div class="portal-glow"></div>
          <div class="ring ring-3"></div>
          <div class="ring ring-2"></div>
          <div class="ring ring-1"></div>
        </div>
        <img src="/media/soma-logo-animated.svg" alt="Soma" width="132" height="132" />
        <div class="moon-egg" onclick="window.location.href='/verse/'" title="✦"></div>
      </div>

      <a href="/docs/what-is-meetsoma-core" class="launch-pill">
        <span class="launch-dot"></span>
        <span>meetsoma core <strong>is now open source</strong></span>
        <span class="launch-ver">{somaVersion.badge}</span>
        <span class="launch-arrow">→</span>
      </a>

      <h1 class="portal-title">
        The agent that <span class="portal-grad">remembers.</span>
      </h1>

      <p class="portal-lede">
        <strong>meetsoma core</strong> is the open-source harness. <strong>Soma</strong> is the agent that lives in it.
        It keeps its memory between sessions, writes its own tools, and picks up exactly where you left off.
      </p>

      <div class="portal-actions">
        <button class="install-pill" data-copy="npm i -g meetsoma" title="Copy install command">
          <span class="install-prompt">$</span>
          <span class="install-cmd">npm i -g meetsoma</span>
          <svg class="copy-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
          <svg class="check-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="display:none"><polyline points="20 6 9 17 4 12"/></svg>
        </button>
        <a href="/docs/getting-started" class="portal-btn portal-btn-primary">Get started</a>
        <a href="https://github.com/meetsoma/core" target="_blank" rel="noopener" class="portal-btn portal-btn-ghost">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true"><path d="M12 .5a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2c-3.3.7-4-1.6-4-1.6-.6-1.4-1.4-1.8-1.4-1.8-1.1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1.1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.8-1.6-2.7-.3-5.5-1.3-5.5-5.9 0-1.3.5-2.4 1.2-3.2-.1-.3-.5-1.5.1-3.2 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0C17.3 4.6 18.3 5 18.3 5c.6 1.7.2 2.9.1 3.2.8.8 1.2 1.9 1.2 3.2 0 4.6-2.8 5.6-5.5 5.9.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6A12 12 0 0 0 12 .5z"/></svg>
          meetsoma/core
        </a>
      </div>

      <p class="portal-note">Free to install. Runs in your terminal. Built on <a href="https://github.com/badlogic/pi-mono" target="_blank" rel="noopener">Pi</a>.</p>
    </header>

    <!-- What remembering looks like — three sessions, one memory -->
    <section class="recall">
      <div class="recall-head">
        <p class="recall-eyebrow">What remembering looks like</p>
        <h2 class="recall-title">Close the terminal. Come back next week.<br/>Soma is still mid-thought.</h2>
      </div>
      <div class="recall-track">
        <article class="recall-card">
          <span class="recall-tag">Session 1</span>
          <p class="recall-you">› set up the auth refactor, tokens first</p>
          <p class="recall-soma">Mapped <code>auth.ts</code> and <code>session.ts</code>. Refresh flow drafted. Left the cookie wrapper for next time.</p>
          <span class="recall-foot">exhale · preload written</span>
        </article>
        <article class="recall-card">
          <span class="recall-tag">Session 2</span>
          <p class="recall-you">› soma inhale</p>
          <p class="recall-soma">Picking up the auth refactor. Tokens are done; the cookie wrapper is next. You prefer small commits, so I'll split it.</p>
          <span class="recall-foot">inhale · memory restored</span>
        </article>
        <article class="recall-card recall-card-glow">
          <span class="recall-tag">Session 47</span>
          <p class="recall-you">› the deploy failed again</p>
          <p class="recall-soma">Same cache key as last month. I wrote a check for this after the second time, running it now.</p>
          <span class="recall-foot">a muscle it grew itself</span>
        </article>
      </div>
    </section>

    <!-- Get Started -->
    <section class="quickstart">
      <SectionHeader title="Get Started" />
      <div class="code-block">
        <div class="code-header">
          <span class="code-dot"></span>
          <span class="code-dot"></span>
          <span class="code-dot"></span>
          <span class="code-label">terminal</span>
        </div>
        <div class="code-body">
          <div class="code-line">
            <span class="code-comment"># Install meetsoma core</span>
          </div>
          <div class="code-line">
            <span class="code-prompt">$</span>
            <span class="code-cmd">npm i -g meetsoma</span>
          </div>
          <div class="code-line">
            <span class="code-comment"># Start a session — Soma learns who you are</span>
          </div>
          <div class="code-line">
            <span class="code-prompt">$</span>
            <span class="code-cmd">soma</span>
          </div>
          <div class="code-line">
            <span class="code-comment"># Focus on a specific topic</span>
          </div>
          <div class="code-line">
            <span class="code-prompt">$</span>
            <span class="code-cmd">soma focus rust</span>
            <button class="copy-btn" data-copy="soma inhale" title="Copy">
              <svg class="copy-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
              <svg class="check-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="display:none"><polyline points="20 6 9 17 4 12"/></svg>
            </button>
          </div>
        </div>
      </div>
    </section>

    <script>
      // Memory motes: particles drift in from the edges and spiral into the agent. Paused offscreen;
      // a single static frame under prefers-reduced-motion.
      (() => {
        const canvas = document.querySelector('.portal-motes') as HTMLCanvasElement | null;
        if (!canvas) return;
        const ctx = canvas.getContext('2d');
        if (!ctx) return;
        const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
        const css = getComputedStyle(document.documentElement);
        const moon = css.getPropertyValue('--moon-bright').trim() || '#7cb2d4';
        const warm = css.getPropertyValue('--warm-bright').trim() || '#e8a87c';
        let w = 0, h = 0, cx = 0, cy = 0, dpr = 1, raf = 0, visible = true;
        type Mote = { a: number; r: number; v: number; s: number; c: string; life: number };
        const motes: Mote[] = [];
        const spawn = (m?: Mote): Mote => {
          const o = m ?? ({} as Mote);
          o.a = Math.random() * Math.PI * 2;
          o.r = Math.max(w, h) * (0.45 + Math.random() * 0.35);
          o.v = 0.25 + Math.random() * 0.6;
          o.s = 0.6 + Math.random() * 1.6;
          o.c = Math.random() < 0.22 ? warm : moon;
          o.life = 0;
          return o;
        };
        const resize = () => {
          dpr = Math.min(devicePixelRatio || 1, 2);
          w = canvas.clientWidth; h = canvas.clientHeight;
          canvas.width = w * dpr; canvas.height = h * dpr;
          ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
          const core = document.querySelector('.portal-core')?.getBoundingClientRect();
          const box = canvas.getBoundingClientRect();
          cx = core ? core.left + core.width / 2 - box.left : w / 2;
          cy = core ? core.top + core.height / 2 - box.top : h * 0.34;
          const n = Math.round(Math.min(160, (w * h) / 9000));
          while (motes.length < n) motes.push(spawn());
          motes.length = n;
          motes.forEach((m) => { m.r *= Math.random(); m.life = 1; });
        };
        const draw = () => {
          ctx.clearRect(0, 0, w, h);
          for (const m of motes) {
            if (!reduce) {
              m.r -= m.v;
              m.a += 0.0016 + 0.5 / Math.max(m.r, 40);
              m.life = Math.min(1, m.life + 0.01);
              if (m.r < 18) spawn(m);
            }
            const x = cx + Math.cos(m.a) * m.r;
            const y = cy + Math.sin(m.a) * m.r * 0.62;
            const near = Math.min(1, m.r / 120);
            ctx.globalAlpha = m.life * (0.15 + 0.6 * (1 - Math.min(1, m.r / (w * 0.6)))) * near;
            ctx.fillStyle = m.c;
            ctx.beginPath();
            ctx.arc(x, y, m.s, 0, Math.PI * 2);
            ctx.fill();
          }
          ctx.globalAlpha = 1;
          if (!reduce && visible) raf = requestAnimationFrame(draw);
        };
        new IntersectionObserver(([e]) => {
          visible = e.isIntersecting;
          cancelAnimationFrame(raf);
          if (visible) draw();
        }).observe(canvas);
        addEventListener('resize', () => { resize(); if (reduce) draw(); });
        resize();
        draw();
      })();

      document.querySelectorAll('.copy-btn, .install-pill').forEach(btn => {
        btn.addEventListener('click', async () => {
          const text = (btn as HTMLElement).dataset.copy || '';
          const copyIcon = btn.querySelector('.copy-icon') as HTMLElement;
          const checkIcon = btn.querySelector('.check-icon') as HTMLElement;
          try {
            await navigator.clipboard.writeText(text);
            copyIcon.style.display = 'none';
            checkIcon.style.display = 'block';
            setTimeout(() => { copyIcon.style.display = 'block'; checkIcon.style.display = 'none'; }, 2000);
          } catch {}
        });
      });
    </script>

    <!-- The Breath — visual storytelling -->
    <section class="breath">
      <SectionHeader title="The Breath Cycle" subtitle="Every session has three phases" />
      <div class="breath-track">
        <div class="breath-phase">
          <div class="breath-dot inhale-dot"></div>
          <div class="breath-line"></div>
          <h3 class="breath-name">Inhale</h3>
          <p class="breath-desc">Identity loads. Memory restores. Protocols activate. The agent wakes up knowing who it is.</p>
        </div>
        <div class="breath-phase">
          <div class="breath-dot hold-dot"></div>
          <div class="breath-line"></div>
          <h3 class="breath-name">Hold</h3>
          <p class="breath-desc">Work. The agent tracks patterns, heats up what's used, cools what isn't. Context is managed automatically.</p>
        </div>
        <div class="breath-phase">
          <div class="breath-dot exhale-dot"></div>
          <h3 class="breath-name">Exhale</h3>
          <p class="breath-desc">Session state saves. Preloads write. Muscles crystallize. Nothing learned is lost.</p>
        </div>
      </div>
      <div class="breath-orb" aria-hidden="true"><span></span></div>
    </section>

    <!-- AMPS — The Content System -->
    <section class="layers">
      <SectionHeader title="The AMPS System" subtitle="Four layers. One agent." link={{ href: "/ecosystem", text: "Explore →" }} />
      <div class="layers-grid">
        <a href="/ecosystem#automations" class="layer-card">
          <div class="layer-icon"><Icon name="automations" size={34} /></div>
          <h3 class="layer-name">Automations</h3>
          <p class="layer-type">triggered actions</p>
          <p class="layer-desc">
            Flows that fire on triggers — session start, post-commit,
            pre-deploy. The reflexes.
          </p>
        </a>

        <a href="/ecosystem#muscles" class="layer-card">
          <div class="layer-icon"><Icon name="muscles" size={34} /></div>
          <h3 class="layer-name">Muscles</h3>
          <p class="layer-type">learned patterns</p>
          <p class="layer-desc">
            Patterns learned from experience — deployment workflows, code conventions,
            API recipes. The muscle memory.
          </p>
        </a>

        <a href="/ecosystem#protocols" class="layer-card">
          <div class="layer-icon"><Icon name="protocols" size={34} /></div>
          <h3 class="layer-name">Protocols</h3>
          <p class="layer-type">behavioral rules</p>
          <p class="layer-desc">
            Rules that shape how the agent thinks. Used ones heat up.
            Unused ones fade. The value system.
          </p>
        </a>

        <a href="/ecosystem#scripts" class="layer-card">
          <div class="layer-icon"><Icon name="scripts" size={34} /></div>
          <h3 class="layer-name">Scripts</h3>
          <p class="layer-type">developer tools</p>
          <p class="layer-desc">
            Bash tools the agent builds and runs. Health checks, deployment
            helpers, verification suites. The toolkit.
          </p>
        </a>
      </div>

      <div class="system-layers">
        <a href="/ecosystem#extensions" class="system-card">
          <span class="system-icon"><Icon name="extensions" size={20} /></span>
          <span class="system-name">Extensions</span>
          <span class="system-type">TypeScript runtime hooks</span>
        </a>
        <a href="/ecosystem#skills" class="system-card">
          <span class="system-icon"><Icon name="skills" size={20} /></span>
          <span class="system-name">Skills</span>
          <span class="system-type">Pi-native knowledge sets</span>
        </a>
      </div>
    </section>

    <!-- Meet the Agents — Template Carousel -->
    <section class="templates">
      <SectionHeader title="Meet the Agents" subtitle="Every template is a personality" link={{ href: "/hub", text: "Browse hub →" }} />
      <TemplateCarousel client:visible />
    </section>

    <!-- Why Soma — condensed from 8 to 4 -->
    <section class="features">
      <SectionHeader title="Why Soma" />
      <div class="features-grid">
        <div class="feature-card">
          <h3 class="feature-title">Memory Persists</h3>
          <p class="feature-desc">
            Sessions end. Memory doesn't. Preloads, muscles, identity — flushed to disk
            and picked back up next time. <code>soma inhale</code> to continue.
          </p>
        </div>
        <div class="feature-card">
          <h3 class="feature-title">Identity Evolves</h3>
          <p class="feature-desc">
            Not pre-configured. Soma's identity grows through use —
            voice, preferences, working patterns. Discovered, not assigned.
          </p>
        </div>
        <div class="feature-card">
          <h3 class="feature-title">Protocols Adapt</h3>
          <p class="feature-desc">
            Behavioral rules that heat up when used and fade when they don't.
            The agent's value system tunes itself to how you work.
          </p>
        </div>
        <div class="feature-card">
          <h3 class="feature-title">Open &amp; Extensible</h3>
          <p class="feature-desc">
            meetsoma core is open source and built on <a href="https://github.com/badlogic/pi-mono" target="_blank" rel="noopener">Pi</a>.
            Extensions, skills and protocols are all swappable, and it
            works alongside CLAUDE.md and the setup you already have.
          </p>
        </div>
      </div>
    </section>

    <!-- The ladder — free at the core, optional above it -->
    <section class="ladder">
      <SectionHeader title="Free at the core" subtitle="Everything above it is optional" />
      <ol class="ladder-steps">
        <li class="ladder-step ladder-step-live">
          <span class="ladder-num">01</span>
          <h3>meetsoma core</h3>
          <p>The harness and the agent. Memory, identity, protocols, tools. Open source, free, yours.</p>
          <span class="ladder-state">available now</span>
        </li>
        <li class="ladder-step">
          <span class="ladder-num">02</span>
          <h3>Register your soma</h3>
          <p>Give your agent a name on the hub and reach the library of community add-ons.</p>
          <span class="ladder-state">coming</span>
        </li>
        <li class="ladder-step">
          <span class="ladder-num">03</span>
          <h3>Somaverse</h3>
          <p>Open your agent's memory as a place: a browser workspace where Soma sees every pane.</p>
          <span class="ladder-state">alpha</span>
        </li>
        <li class="ladder-step">
          <span class="ladder-num">04</span>
          <h3>Pro &amp; teams</h3>
          <p>Hosted infrastructure for teams that want their agents running without the upkeep.</p>
          <span class="ladder-state">later</span>
        </li>
      </ol>
    </section>

    <!-- From the blog -->
    {recentPosts.length > 0 && (
      <section class="from-blog">
        <SectionHeader title="From the blog" link={{ href: "/blog", text: "All posts →" }} />
        <div class="recent-posts">
          {recentPosts.map((post, i) => (
            <a href={blogPostUrl(post)} class:list={['recent-post-card', { 'recent-post-promo': i === 0 }]}>
              {i === 0 && <span class="recent-post-badge">New</span>}
              <span class="recent-post-title">{post.data.title}</span>
              <span class="recent-post-arrow">→</span>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- Somaverse teaser -->
    <section class="verse-teaser">
      <SectionHeader title="Somaverse" subtitle="Give your agent eyes and hands" />
      <div class="verse-content">
        <div class="verse-text">
          <p>Soma lives in the terminal. Somaverse gives it a workspace.</p>
          <p>A tiling workspace in your browser with 21 plugins. Terminal, files, editor, browser, chat, voice. Your agent sees every pane, sends commands, navigates the web.</p>
          <p>Not a chatbot with plugins. An agent with eyes.</p>
          <div class="verse-cta">
            <a href="/blog/somaverse-preview" class="verse-link">Read the preview &rarr;</a>
            <span class="verse-status">Alpha &mdash; Genesis coming soon</span>
          </div>
        </div>
        <div class="verse-visual">
          <div class="verse-pane-single">
            <div class="verse-pane-header">
              <span class="verse-pane-grip" aria-hidden="true">
                <span></span><span></span><span></span><span></span><span></span><span></span>
              </span>
              <span class="verse-pane-title">CHAT · SOMA</span>
              <span class="verse-pane-mono">workspace →</span>
            </div>
            <div class="verse-pane-body">
              <div class="verse-msg user"><span class="verse-msg-prefix">you</span>what's in src/ that handles auth?</div>
              <div class="verse-msg agent">
                <span class="verse-msg-prefix">soma</span>I can see <code>src/</code> in the files pane.
                Two files: <code>auth.ts</code> (token + refresh) and <code>session.ts</code> (cookie wrapper).
                Want me to open <code>auth.ts</code> in the editor?
              </div>
              <div class="verse-pane-pips">
                <span class="pip">terminal</span>
                <span class="pip">files</span>
                <span class="pip">editor</span>
                <span class="pip">browser</span>
                <span class="pip">voice</span>
                <span class="pip more">+16</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA with ecosystem links -->
    <section class="cta-section">
      <div class="cta-content">
        <div class="cta-halo" aria-hidden="true"><span></span><span></span></div>
        <h2 class="cta-title">Give your agent a memory.</h2>
        <p class="cta-desc">Install meetsoma core, start a session, and Soma takes it from there.</p>
        <div class="cta-buttons">
          <button class="install-pill" data-copy="npm i -g meetsoma" title="Copy install command">
            <span class="install-prompt">$</span>
            <span class="install-cmd">npm i -g meetsoma</span>
            <svg class="copy-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
            <svg class="check-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="display:none"><polyline points="20 6 9 17 4 12"/></svg>
          </button>
          <a href="/docs/getting-started" class="portal-btn portal-btn-primary">Get started</a>
          <a href="https://github.com/meetsoma/core" target="_blank" rel="noopener" class="portal-btn portal-btn-ghost">GitHub</a>
        </div>
        <div class="cta-links">
          <a href="/docs/getting-started" class="cta-link">
            ⚡ Get Started
          </a>
          <span class="cta-sep">·</span>
          <a href="/blog" class="cta-link">Blog</a>
          <span class="cta-sep">·</span>
          <a href="/hub" class="cta-link">Hub</a>
          <span class="cta-sep">·</span>
          <a href="https://github.com/meetsoma" target="_blank" rel="noopener" class="cta-link">GitHub</a>
        </div>
      </div>
    </section>

  </main>
</Layout>

<style>
  /* Design tokens: see Layout.astro :root */

  .container {
    position: relative;
    z-index: 1;
    max-width: 1040px;
    margin: 0 auto;
    padding: var(--space-3xl) var(--space-xl) var(--space-2xl);
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  /* ── Portal hero ── */
  .portal {
    position: relative;
    min-height: calc(100vh - 120px);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: var(--space-2xl) 0 var(--space-3xl);
    margin-bottom: var(--space-2xl);
    isolation: isolate;
  }
  .portal-stage {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 100vw;
    height: 120%;
    transform: translate(-50%, -54%);
    pointer-events: none;
    z-index: -1;
    overflow: hidden;
    -webkit-mask-image: radial-gradient(ellipse 60% 55% at 50% 42%, #000 40%, transparent 100%);
            mask-image: radial-gradient(ellipse 60% 55% at 50% 42%, #000 40%, transparent 100%);
  }
  .portal-motes { position: absolute; inset: 0; width: 100%; height: 100%; }
  .portal-rings { position: absolute; top: 50%; left: 50%; width: 0; height: 0; z-index: -1; animation: rings-breathe 8s ease-in-out infinite; will-change: transform; }
  @keyframes rings-breathe { 0%, 100% { transform: scale(1); } 50% { transform: scale(1.045); } }
  .ring {
    position: absolute;
    top: 0;
    left: 0;
    border-radius: 50%;
    transform: translate(-50%, -50%);
    border: 1.5px solid transparent;
    background:
      conic-gradient(from 0deg, transparent 0deg, var(--moon-bright) 60deg, transparent 150deg,
        transparent 200deg, var(--warm-bright) 245deg, transparent 330deg) border-box;
    -webkit-mask: linear-gradient(#000 0 0) padding-box, linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
            mask-composite: exclude;
  }
  .ring { will-change: transform; }
  .ring-1 { width: 260px; height: 260px; animation: ring-spin 18s linear infinite; opacity: .75; }
  .ring-2 { width: 440px; height: 440px; animation: ring-spin 34s linear infinite reverse; opacity: .45; }
  .ring-3 { width: 660px; height: 660px; animation: ring-spin 60s linear infinite; opacity: .25; }
  @keyframes ring-spin {
    from { transform: translate(-50%, -50%) rotate(0deg); }
    to   { transform: translate(-50%, -50%) rotate(360deg); }
  }
  @keyframes portal-breathe {
    0%, 100% { transform: translate(-50%, -50%) scale(1); }
    50%      { transform: translate(-50%, -50%) scale(1.045); }
  }
  .portal-glow {
    position: absolute;
    top: 0;
    left: 0;
    width: 420px;
    height: 420px;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    background: radial-gradient(circle, var(--moon-glow) 0%, rgba(124,178,212,0.08) 38%, transparent 70%);
    filter: blur(8px);
    transform: translate(-50%, -50%);
  }
  .portal-core {
    position: relative;
    width: 132px;
    height: 132px;
    margin-bottom: var(--space-2xl);
    animation: float 5s ease-in-out infinite;
  }
  .portal-core img { width: 100%; height: 100%; filter: drop-shadow(0 0 28px var(--logo-glow)); }
  .portal-core .moon-egg { top: 30px; right: 8px; width: 31px; height: 31px; }

  .launch-pill {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 7px 10px 7px 14px;
    margin-bottom: var(--space-xl);
    border-radius: var(--radius-full);
    border: 1px solid color-mix(in srgb, var(--moon-bright) 35%, transparent);
    background: color-mix(in srgb, var(--bg) 70%, transparent);
    backdrop-filter: blur(10px);
    color: var(--ink-dim, var(--ink));
    font-size: var(--text-sm);
    text-decoration: none;
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--moon-bright) 6%, transparent), 0 8px 30px -12px var(--moon-glow);
    animation: fadeUp .8s ease-out .15s both;
    transition: border-color .25s, transform .25s;
  }
  .launch-pill:hover { border-color: var(--moon-bright); transform: translateY(-1px); }
  .launch-pill strong { color: var(--ink); font-weight: 600; }
  .launch-dot {
    width: 7px; height: 7px; border-radius: 50%;
    background: var(--warm-bright);
    box-shadow: 0 0 0 0 var(--warm-glow);
    animation: pulse-dot 2.4s ease-out infinite;
  }
  @keyframes pulse-dot {
    0%   { box-shadow: 0 0 0 0 var(--warm-glow); }
    70%  { box-shadow: 0 0 0 10px transparent; }
    100% { box-shadow: 0 0 0 0 transparent; }
  }
  .launch-ver {
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: var(--text-xs);
    padding: 2px 8px;
    border-radius: var(--radius-full);
    background: color-mix(in srgb, var(--moon-bright) 16%, transparent);
    color: var(--moon-bright);
  }
  .launch-arrow { color: var(--moon-bright); transition: transform .25s; }
  .launch-pill:hover .launch-arrow { transform: translateX(3px); }

  .portal-title {
    font-size: clamp(2.6rem, 6.4vw, 5.2rem);
    line-height: 1.02;
    letter-spacing: -0.035em;
    font-weight: 700;
    color: var(--ink);
    margin: 0 0 var(--space-xl);
    max-width: 14ch;
    animation: fadeUp .9s ease-out .25s both;
  }
  .portal-grad {
    background: linear-gradient(100deg, var(--moon-bright) 0%, #b9d8ec 38%, var(--warm-bright) 78%, var(--moon-bright) 100%);
    background-size: 220% 100%;
    -webkit-background-clip: text;
            background-clip: text;
    color: transparent;
    animation: grad-drift 9s ease-in-out infinite;
  }
  @keyframes grad-drift { 0%,100% { background-position: 0% 50%; } 50% { background-position: 100% 50%; } }
  .portal-lede {
    max-width: 600px;
    margin: 0 auto var(--space-2xl);
    font-size: clamp(1.02rem, 1.4vw, 1.18rem);
    line-height: var(--leading-relaxed);
    color: var(--ink-dim, var(--ink));
    opacity: .9;
    animation: fadeUp .9s ease-out .35s both;
  }
  .portal-lede strong { color: var(--ink); font-weight: 600; }
  .portal-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: var(--space-md);
    animation: fadeUp .9s ease-out .45s both;
  }
  .install-pill {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    height: 48px;
    padding: 0 16px 0 18px;
    border-radius: var(--radius-lg);
    border: 1px solid color-mix(in srgb, var(--ink) 14%, transparent);
    background: color-mix(in srgb, var(--bg) 82%, black 18%);
    color: var(--ink);
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 15px;
    cursor: pointer;
    transition: border-color .2s, box-shadow .2s;
  }
  .install-pill:hover { border-color: var(--moon-bright); box-shadow: 0 0 24px -6px var(--moon-glow); }
  .install-prompt { color: var(--warm-bright); }
  .install-pill svg { width: 16px; height: 16px; opacity: .6; }
  .portal-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 48px;
    padding: 0 22px;
    border-radius: var(--radius-lg);
    font-weight: 600;
    font-size: var(--text-sm);
    text-decoration: none;
    transition: transform .2s, box-shadow .2s, background .2s;
  }
  .portal-btn-primary {
    background: linear-gradient(180deg, var(--moon-bright), var(--accent-mid));
    color: #06121c;
    box-shadow: 0 10px 30px -10px var(--moon-glow), inset 0 1px 0 rgba(255,255,255,.35);
  }
  .portal-btn-primary:hover { transform: translateY(-1px); box-shadow: 0 14px 38px -10px var(--moon-glow), inset 0 1px 0 rgba(255,255,255,.35); }
  .portal-btn-ghost {
    color: var(--ink);
    border: 1px solid color-mix(in srgb, var(--ink) 16%, transparent);
    background: color-mix(in srgb, var(--bg) 50%, transparent);
  }
  .portal-btn-ghost:hover { border-color: color-mix(in srgb, var(--ink) 40%, transparent); }
  .portal-note {
    margin-top: var(--space-xl);
    font-size: var(--text-sm);
    color: var(--ink-dim, var(--ink));
    opacity: .6;
    animation: fadeUp .9s ease-out .55s both;
  }
  .portal-note a { color: inherit; text-decoration-color: color-mix(in srgb, currentColor 40%, transparent); }

  /* Light surface: the dark-mode mixes (bg + black, pale gradient start, dark-on-blue) lose contrast on a day sky. */
  :global([data-surface="light"]) .install-pill {
    background: color-mix(in srgb, white 70%, transparent);
    border-color: color-mix(in srgb, var(--ink) 18%, transparent);
  }
  :global([data-surface="light"]) .portal-grad {
    background-image: linear-gradient(100deg, #1e5a98 0%, #2870b0 40%, #c0682a 80%, #1e5a98 100%);
  }
  :global([data-surface="light"]) .portal-btn-primary { color: #fff; }
  :global([data-surface="light"]) .launch-pill { background: color-mix(in srgb, white 65%, transparent); }

  /* ── Recall: three sessions, one memory ── */
  .recall { margin-bottom: var(--section-gap); }
  .recall-head { text-align: center; margin-bottom: var(--space-2xl); }
  .recall-eyebrow {
    font-size: var(--text-xs);
    letter-spacing: .18em;
    text-transform: uppercase;
    color: var(--moon-bright);
    margin: 0 0 var(--space-md);
  }
  .recall-title {
    font-size: clamp(1.5rem, 3vw, 2.2rem);
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--ink);
    margin: 0;
  }
  .recall-track {
    position: relative;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-lg);
  }
  .recall-track::before {
    content: '';
    position: absolute;
    top: 22px;
    left: 8%;
    right: 8%;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--moon-glow), var(--warm-glow), transparent);
    background-size: 200% 100%;
    animation: thread 6s linear infinite;
    z-index: 0;
  }
  @keyframes thread { to { background-position: -200% 0; } }
  .recall-card {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: var(--space-lg);
    border-radius: var(--radius-lg);
    border: 1px solid color-mix(in srgb, var(--ink) 10%, transparent);
    background: color-mix(in srgb, var(--bg) 78%, transparent);
    backdrop-filter: blur(12px);
    text-align: left;
  }
  .recall-card-glow {
    border-color: color-mix(in srgb, var(--warm-bright) 40%, transparent);
    box-shadow: 0 0 40px -18px var(--warm-glow);
  }
  .recall-tag {
    align-self: flex-start;
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: var(--text-xs);
    padding: 3px 9px;
    border-radius: var(--radius-full);
    background: color-mix(in srgb, var(--moon-bright) 14%, transparent);
    color: var(--moon-bright);
  }
  .recall-card-glow .recall-tag { background: color-mix(in srgb, var(--warm-bright) 16%, transparent); color: var(--warm-bright); }
  .recall-you {
    margin: 0;
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 13px;
    color: var(--ink-dim, var(--ink));
    opacity: .75;
  }
  .recall-soma { margin: 0; font-size: var(--text-sm); line-height: var(--leading-relaxed); color: var(--ink); }
  .recall-soma code { font-size: .9em; }
  .recall-foot {
    margin-top: auto;
    padding-top: 8px;
    font-size: var(--text-xs);
    color: var(--ink-dim, var(--ink));
    opacity: .55;
    border-top: 1px dashed color-mix(in srgb, var(--ink) 12%, transparent);
  }

  /* ── Ladder ── */
  .ladder { margin-bottom: var(--section-gap); }
  .ladder-steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-md);
    counter-reset: none;
  }
  .ladder-step {
    position: relative;
    padding: var(--space-lg);
    border-radius: var(--radius-lg);
    border: 1px solid color-mix(in srgb, var(--ink) 9%, transparent);
    background: color-mix(in srgb, var(--bg) 70%, transparent);
    display: flex;
    flex-direction: column;
    gap: 8px;
    opacity: .78;
  }
  .ladder-step h3 { margin: 0; font-size: var(--text-base); color: var(--ink); }
  .ladder-step p { margin: 0; font-size: var(--text-sm); line-height: var(--leading-normal); color: var(--ink-dim, var(--ink)); }
  .ladder-num { font-family: var(--font-mono, ui-monospace, monospace); font-size: var(--text-xs); color: var(--ink-dim, var(--ink)); opacity: .6; }
  .ladder-state {
    margin-top: auto;
    align-self: flex-start;
    font-size: var(--text-xs);
    padding: 2px 8px;
    border-radius: var(--radius-full);
    border: 1px solid color-mix(in srgb, var(--ink) 15%, transparent);
    color: var(--ink-dim, var(--ink));
  }
  .ladder-step-live {
    opacity: 1;
    border-color: color-mix(in srgb, var(--moon-bright) 45%, transparent);
    background: linear-gradient(180deg, color-mix(in srgb, var(--moon-bright) 10%, transparent), color-mix(in srgb, var(--bg) 70%, transparent));
    box-shadow: 0 0 40px -20px var(--moon-glow);
  }
  .ladder-step-live .ladder-state { border-color: var(--moon-bright); color: var(--moon-bright); }

  @media (max-width: 760px) {
    .portal { min-height: auto; padding-top: var(--space-xl); }
    .ring-3 { display: none; }
    .ring-2 { width: 400px; height: 400px; }
    .ring-1 { width: 240px; height: 240px; }
    .portal-actions { flex-direction: column; width: 100%; }
    .launch-pill { font-size: 12.5px; gap: 8px; white-space: nowrap; }
    .launch-ver { display: none; }
    .recall-title br { display: none; }
    .install-pill, .portal-btn { width: 100%; justify-content: center; }
    .recall-track, .ladder-steps { grid-template-columns: 1fr; }
    .recall-track::before { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .ring, .portal-rings, .portal-grad, .launch-dot, .recall-track::before, .portal-core,
    .breath-orb span, .breath-phase::after { animation: none !important; }
  }

  /* ── Hero (legacy, unused) ── */
  .hero {
    text-align: center;
    margin-bottom: var(--section-gap);
    padding-top: var(--space-2xl);
    animation: fadeUp 0.8s ease-out;
  }

  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(var(--space-xl)); }
    to { opacity: 1; transform: translateY(0); }
  }

  .hero-icon {
    position: relative;
    width: 144px;
    height: 144px;
    margin: 0 auto var(--space-2xl);
    animation: float 5s ease-in-out infinite;
  }

  .moon-egg {
    position: absolute;
    top: 33px;
    right: 9px;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    cursor: pointer;
    z-index: 3;
  }

  .hero-icon img {
    width: 100%;
    height: 100%;
    filter: drop-shadow(0 0 var(--space-xl) var(--logo-glow));
    transition: filter 0.3s;
  }

  .hero-icon:hover img {
    filter: drop-shadow(0 0 var(--space-2xl) var(--logo-glow-hover));
  }

  @keyframes float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-8px); }
  }

  .title {
    position: relative;
    display: inline-flex;
    align-items: flex-start;
    gap: var(--space-md);
    font-family: var(--font-display);
    font-size: clamp(3.5rem, 12vw, 5.5rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: var(--leading-none);
    margin-bottom: var(--space-lg);
    transform: translateX(-1.5%);
  }

  .title-main {
    font-family: 'Manrope', system-ui, sans-serif;
    font-weight: 800;
    /* Dark surface: pale gradient (silvery sheen on dark sky) */
    background: linear-gradient(135deg, #f0f4fa 0%, #e4eaf4 40%, #a8c4d8 80%, #e4eaf4 100%);
    background-size: 200% 200%;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    animation: gradientShift 8s ease infinite;
  }
  /* Light surface: deeper blue — sun behind the letters, so they read as
   * silhouette/silvery-shadow against the bright sky. Curtis (s01-b73653):
   * "the Soma white/blue text should get a little deeper blue (since the
   * sun is shining from behind it would make sense)." */
  html[data-surface='light'] .title-main {
    background: linear-gradient(135deg, #1a3258 0%, #2a4f80 40%, #4878a8 80%, #2a4f80 100%);
    background-size: 200% 200%;
    -webkit-background-clip: text;
    background-clip: text;
  }

  .title-sigma {
    -webkit-text-fill-color: var(--promo-text);
    filter: drop-shadow(0 0 12px var(--promo-glow));
  }

  .beta-badge {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: var(--label-text);
    font-weight: var(--weight-semibold);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--bg);
    /* Solid bright orange — the previous gradient slid into brown at the
     * bottom-right stop. Vivid throughout reads like a brand sticker. */
    background: var(--promo);
    padding: var(--radius-sm) var(--space-md);
    border-radius: var(--radius-md);
    margin-top: 0.15em;
    -webkit-text-fill-color: var(--bg);
    animation: badgeBob 3s ease-in-out infinite;
    flex-shrink: 0;
    text-decoration: none;
    box-shadow: 0 1px 2px rgba(0,0,0,0.08), 0 4px 8px var(--promo-glow);
  }

  @keyframes badgeBob {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-5px); }
  }

  @keyframes gradientShift {
    0%, 100% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
  }

  .tagline {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 900;
    color: var(--accent);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin-bottom: var(--space-xl);
  }

  .description {
    font-size: var(--text-lg);
    color: var(--ink-soft);
    max-width: var(--content-wide);
    margin: 0 auto;
    line-height: var(--leading-relaxed);
  }

  .description a {
    color: var(--accent);
    text-decoration: none;
    border-bottom: 1px solid var(--border-accent);
    transition: color 0.2s;
  }

  .description a:hover { color: var(--moon-bright); }

  /* ── Recent Posts ── */
  .from-blog { margin-bottom: var(--section-gap); }

  /* Closing CTA: the portal motif again, smaller — two static rings, one slow rotation. */
  .cta-content { position: relative; isolation: isolate; overflow: hidden; }
  .cta-halo { position: absolute; top: 46%; left: 50%; width: 0; height: 0; z-index: -1; pointer-events: none; }
  .cta-halo span {
    position: absolute;
    top: 0; left: 0;
    border-radius: 50%;
    border: 1px solid transparent;
    background: conic-gradient(from 0deg, transparent, var(--moon-bright) 70deg, transparent 150deg, transparent 210deg, var(--warm-bright) 260deg, transparent 330deg) border-box;
    -webkit-mask: linear-gradient(#000 0 0) padding-box, linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
            mask-composite: exclude;
    animation: ring-spin 40s linear infinite;
    will-change: transform;
  }
  .cta-halo span:nth-child(1) { width: 380px; height: 380px; opacity: .35; }
  .cta-halo span:nth-child(2) { width: 620px; height: 620px; opacity: .18; animation-direction: reverse; animation-duration: 70s; }
  .cta-title { font-size: clamp(1.8rem, 4vw, 2.8rem) !important; letter-spacing: -0.03em; }
  .cta-section .cta-buttons { display: flex; flex-wrap: wrap; justify-content: center; gap: var(--space-md); }
  @media (prefers-reduced-motion: reduce) { .cta-halo span { animation: none !important; } }
  .recent-posts {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-md);
  }
  @media (max-width: 768px) { .recent-posts { grid-template-columns: 1fr; } }

  .recent-post-card {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    padding: var(--space-lg);
    min-height: 92px;
    border-radius: var(--radius-lg);
    border: 1px solid var(--border);
    background: var(--surface-card);
    box-shadow: var(--shadow-elevated);
    text-decoration: none;
    color: var(--ink);
    transition: all 0.25s ease;
  }

  .recent-post-card:hover {
    border-color: var(--border-accent);
    transform: translateY(-2px);
    box-shadow: 0 var(--space-md) var(--space-xl) var(--shadow-accent-soft);
  }

  .recent-post-badge {
    font-family: var(--font-display);
    font-size: var(--badge-text);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--bg);
    background: var(--promo);
    padding: var(--space-xs) var(--space-md);
    border-radius: var(--radius-md);
    flex-shrink: 0;
  }

  .recent-post-promo {
    border-color: var(--promo-border);
    background: linear-gradient(135deg, var(--surface-card) 0%, rgba(240, 200, 102, 0.03) 100%);
  }

  .recent-post-promo:hover {
    border-color: var(--promo-text);
    box-shadow: 0 var(--space-md) var(--space-xl) rgba(240, 200, 102, 0.08), inset 0 0 0 1px var(--promo-border);
  }

  .recent-post-title {
    flex: 1;
    font-size: var(--body-text);
    font-weight: 500;
  }

  .recent-post-arrow {
    color: var(--ink-muted);
    font-size: var(--text-lg);
    transition: transform 0.2s;
    flex-shrink: 0;
  }

  .recent-post-card:hover .recent-post-arrow { transform: translateX(5px); }

  /* ── Quick Start ── */
  .quickstart {
    margin-bottom: var(--section-gap);
    animation: fadeUp 0.8s ease-out 0.2s both;
  }

  .code-block {
    border-radius: var(--radius-lg);
    border: 1px solid var(--border);
    background: var(--surface-card-strong);
    overflow: hidden;
  }

  .code-header {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    padding: var(--space-lg) var(--space-xl);
    border-bottom: 1px solid var(--border);
  }

  .code-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--surface-interactive);
  }

  .code-label {
    margin-left: var(--space-md);
    font-family: var(--font-mono);
    font-size: var(--label-text);
    color: var(--ink-muted);
  }

  .code-body {
    padding: var(--space-xl);
    font-family: var(--font-mono);
    font-size: var(--body-secondary);
    line-height: var(--leading-loose);
  }

  .code-line {
    display: flex;
    align-items: center;
    gap: var(--space-md);
  }

  .code-prompt {
    color: var(--accent);
    user-select: none;
  }

  .code-cmd { color: var(--ink); }

  .code-comment {
    color: var(--ink-muted);
    font-style: italic;
  }

  .copy-btn {
    margin-left: auto;
    background: none;
    border: none;
    color: var(--ink-muted);
    cursor: pointer;
    padding: var(--space-sm);
    border-radius: var(--radius-md);
    transition: color 0.2s, background 0.2s;
    display: flex;
    align-items: center;
  }

  .copy-btn:hover {
    color: var(--accent);
    background: var(--surface-interactive);
  }

