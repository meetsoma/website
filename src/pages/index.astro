  /* ── Breath Cycle ── */
  .breath {
    margin-bottom: var(--section-gap);
    animation: fadeUp 0.8s ease-out 0.3s both;
    position: relative;
    isolation: isolate;
  }

  .breath-track {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-md);
    position: relative;
    margin-top: var(--space-xl);
  }

  /* One 12s breath: each phase lights for its third of the cycle, the orb grows / holds / shrinks with it. */
  .breath-phase {
    text-align: center;
    padding: var(--space-xl) var(--space-lg);
    position: relative;
    border-radius: var(--radius-lg);
    border: 1px solid color-mix(in srgb, var(--ink) 8%, transparent);
    background: color-mix(in srgb, var(--bg) 80%, transparent);
  }
  /* The lit state is a pseudo-element animating OPACITY only — no per-frame repaint of borders/shadows. */
  .breath-phase::after {
    content: '';
    position: absolute;
    inset: -1px;
    border-radius: inherit;
    border: 1px solid color-mix(in srgb, var(--moon-bright) 50%, transparent);
    box-shadow: 0 0 40px -16px var(--moon-glow);
    opacity: 0;
    animation: phase-lit 12s ease-in-out infinite;
    pointer-events: none;
  }
  .breath-phase:nth-child(2)::after { animation-delay: 4s; }
  .breath-phase:nth-child(3)::after { animation-delay: 8s; }
  @keyframes phase-lit {
    0%, 30%   { opacity: 1; }
    36%, 100% { opacity: 0; }
  }
  .breath-orb {
    position: absolute;
    left: 50%;
    top: 58%;
    width: 520px;
    height: 520px;
    transform: translate(-50%, -50%);
    z-index: -1;
    pointer-events: none;
  }
  .breath-orb span {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: radial-gradient(circle at 50% 45%, var(--moon-glow) 0%, rgba(124,178,212,0.10) 35%, transparent 68%);
    animation: orb-breath 12s ease-in-out infinite;
    will-change: transform, opacity;
  }
  @keyframes orb-breath {
    0%   { transform: scale(0.55); opacity: .35; }
    33%  { transform: scale(1);    opacity: .9; }
    66%  { transform: scale(1);    opacity: .9; }
    100% { transform: scale(0.55); opacity: .35; }
  }

  .breath-dot {
    width: 16px;
    height: 16px;
    border-radius: 50%;
    margin: 0 auto var(--space-lg);
    position: relative;
    z-index: 2;
